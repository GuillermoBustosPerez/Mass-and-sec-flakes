  issn = {0197-7261, 2051-6185},
  doi = {10.1080/01977261.2026.2732584},
  urldate = {2026-09-29},
  abstract = {Lithic flakes are central to Paleolithic assemblages, and their variability provides key insights into stone-tool technology, decision making, and hominin motor control. Mechanical flaking experiments isolate the main drivers of flake size and shape, but most have used glass plates or cuboid cores with Levallois-like surfaces. These standardized forms have clarified relationships among flake mass, platform depth, angle of blow, exterior platform angle, and force. Whether these findings generalize to markedly different core morphologies remains uncertain. To evaluate this, we conducted controlled mechanical experiments using glass hemispheres that approximate Oldowan pebble cores, producing 177 flakes under systematic variation in platform depth and angle of blow. Attribute analysis and 3D landmarking were used to assess flake features and their fit to existing models. The results show strong consistency with previous experiments, indicating that principles derived from standardized cores extend to hemispherical morphologies and across Paleolithic contexts.},
  langid = {english},
  file = {C:\Users\guill\Zotero\storage\6ERSWQGD\Bustos-Pérez y McPherron - 2026 - The Rules are the Rules. Consistency of Drivers of Flake Size and Shape in Mechanical Flaking Experi.pdf}
}

@article{mcpherronIntroducingPlatformSurface2020,
  title = {Introducing Platform Surface Interior Angle ({{PSIA}}) and Its Role in Flake Formation, Size and Shape},
  author = {McPherron, Shannon P. and Abdolahzadeh, Aylar and Archer, Will and Chan, Annie and Djakovic, Igor and Dogand{\v z}i{\'c}, Tamara and Leader, George M. and Li, Li and Lin, Sam and Magnani, Matthew and Reeves, Jonathan and Rezek, Zeljko and Weiss, Marcel},
  editor = {Wang, Jianguo},
  year = 2020,
  month = nov,
  journal = {PLOS ONE},
  volume = {15},
  number = {11},
  pages = {e0241714},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0241714},
  urldate = {2022-03-21},
  abstract = {Four ways archaeologists have tried to gain insights into how flintknapping creates lithic variability are fracture mechanics, controlled experimentation, replication and attribute studies of lithic assemblages. Fracture mechanics has the advantage of drawing more directly on first principles derived from physics and material sciences, but its relevance to controlled experimentation, replication and lithic studies more generally has been limited. Controlled experiments have the advantage of being able to isolate and quantify the contribution of individual variables to knapping outcomes, and the results of these experiments have provided models of flake formation that when applied to the archaeological record of flintknapping have provided insights into past behavior. Here we develop a linkage between fracture mechanics and the results of previous controlled experiments to increase their combined explanatory and predictive power. We do this by documenting the influence of Herztian cone formation, a constant in fracture mechanics, on flake platforms. We find that the platform width is a function of the Hertzian cone constant angle and the geometry of the platform edge. This finding strengthens the foundation of one of the more influential models emerging from the controlled experiments. With additional work, this should make it possible to merge more of the experimental results into a more comprehensive model of flake formation.},
  langid = {english},
  file = {C:\Users\guill\Zotero\storage\PZD6IFB4\McPherron et al. - 2020 - Introducing platform surface interior angle (PSIA).pdf}
}
