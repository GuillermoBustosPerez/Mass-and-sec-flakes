@article{plummerExpandedGeographicDistribution2023,
  title = {Expanded Geographic Distribution and Dietary Strategies of the Earliest {{Oldowan}} Hominins and {{Paranthropus}}},
  author = {Plummer, Thomas W. and Oliver, James S. and Finestone, Emma M. and Ditchfield, Peter W. and Bishop, Laura C. and Blumenthal, Scott A. and Lemorini, Cristina and Caricola, Isabella and Bailey, Shara E. and Herries, Andy I. R. and Parkinson, Jennifer A. and Whitfield, Elizabeth and Hertel, Fritz and Kinyanjui, Rahab N. and Vincent, Thomas H. and Li, Youjuan and Louys, Julien and Frost, Stephen R. and Braun, David R. and Reeves, Jonathan S. and Early, Emily D. G. and Onyango, Blasto and {Lamela-Lopez}, Raquel and Forrest, Frances L. and He, Huaiyu and Lane, Timothy P. and Frouin, Marine and Nomade, S{\'e}bastien and Wilson, Evan P. and Bartilol, Simion K. and Rotich, Nelson Kiprono and Potts, Richard},
  year = 2023,
  month = feb,
  journal = {Science},
  volume = {379},
  number = {6632},
  pages = {561--566},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.abo7452},
  urldate = {2024-07-27},
  abstract = {The oldest Oldowan tool sites, from around 2.6 million years ago, have previously been confined to Ethiopia's Afar Triangle. We describe sites at Nyayanga, Kenya, dated to 3.032 to 2.581 million years ago and expand this distribution by over 1300 kilometers. Furthermore, we found two hippopotamid butchery sites associated with mosaic vegetation and a C4 grazer--dominated fauna. Tool flaking proficiency was comparable with that of younger Oldowan assemblages, but pounding activities were more common. Tool use-wear and bone damage indicate plant and animal tissue processing. Paranthropus sp. teeth, the first from southwestern Kenya, possessed carbon isotopic values indicative of a diet rich in C4 foods. We argue that the earliest Oldowan was more widespread than previously known, used to process diverse foods including megafauna, and associated with Paranthropus from its onset.},
  file = {C:\Users\guillermo_bustos_perez\Zotero\storage\ULF2SQRU\Plummer et al. - 2023 - Expanded geographic distribution and dietary strat.pdf}
}

